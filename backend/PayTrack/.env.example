# Backend secrets — copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# JWT
# Secret key used to sign and verify JWT tokens. Use a long random string (32+ chars).
JWT_SECRET=change-me-to-a-long-random-secret

# Email (SMTP)
# Credentials for the SMTP relay used to send notification emails.
# For local development, Mailtrap (sandbox.smtp.mailtrap.io) works well.
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Slack
# Bot token for posting notifications to Slack channels. Starts with xoxb-.
SLACK_BOT_TOKEN=

# Google Drive (optional)
# Only required when GoogleDrive:Enabled = true in appsettings.
# Base64-encoded content of the Google service account JSON key file.
# Generate with: base64 -w 0 service-account-key.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_BASE64=
