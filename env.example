# Google cloud setup (not yet used!)
GOOGLE_CLIENT_ID=123
# Leave empty for same-origin requests in deployment.
# For local frontend development against the local backend, set this to http://localhost:5154
API_BASE_URL=
GOOGLE_CLIENT_SECRET=123

# Google Drive archive setup
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=google-drive-root-folder-id

# Use exactly one of these two service account credential sources.
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/service-account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_BASE64=base64-encoded-service-account-json

### SONARQUBE

# Replace with tokens generated in Sonarqube for each project
SONARQUBE_TOKEN_BACKEND=sqp_123456xxx
SONARQUBE_TOKEN_FRONTEND=sqp_123456xxx

# replace with project names defined in sonarqube
SONAR_PROJECT_NAME_BACKEND=PayTrack_Backend
SONAR_PROJECT_NAME_FRONTEND=PayTrack_Frontend
