{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "core-api-views",
      "urls": [
        "/api/v1/auth/currentuser**",
        "/api/v1/transaction/user**",
        "/api/v1/transaction/team**",
        "/api/v1/team**",
        "/api/v1/budget**",
        "/api/v1/cost-centre**",
        "/api/v1/bankaccount**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "6h",
        "timeout": "5s"
      }
    }
  ]
}
